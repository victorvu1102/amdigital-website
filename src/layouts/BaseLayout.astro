---
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import ChatLive from '../components/layout/ChatLive.astro';
import SEO from '../components/seo/SEO.astro';
import Schema from '../components/seo/Schema.astro';
import { organizationSchema } from '../utils/schema';
import '../styles/global.css';
interface Props { title?: string; description?: string; type?: 'website' | 'article'; schema?: Record<string, unknown> | Record<string, unknown>[]; robots?: string; }
const { title, description, type = 'website', schema, robots } = Astro.props;
const schemas = schema ? [organizationSchema(Astro.site!), ...(Array.isArray(schema) ? schema : [schema])] : organizationSchema(Astro.site!);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <!-- Google Tag Manager -->
    <script is:inline>
      (function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
      new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
      j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
      'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
      })(window,document,'script','dataLayer','GTM-5G9WFQZB');
    </script>
    <!-- End Google Tag Manager -->
    <meta name="viewport" content="width=device-width" />
    <meta name="theme-color" content="#071a2d" />
    <link rel="icon" type="image/png" href="/favicon/favicon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <SEO {title} {description} canonical={Astro.url} {type} {robots} />
    <Schema data={schemas} />
  </head>
  <body>
    <!-- Google Tag Manager (noscript) -->
    <noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-5G9WFQZB"
    height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
    <!-- End Google Tag Manager (noscript) -->
    <a class="skip-link" href="#main-content">Skip to content</a>
    <Header />
    <main id="main-content"><slot /></main>
    <Footer />
    <ChatLive />
    <script>
      import { initScrollAnimation } from '../components/interactive/ScrollAnimation';
      initScrollAnimation();
    </script>
  </body>
</html>
