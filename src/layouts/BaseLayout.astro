---
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import ChatLive from '../components/layout/ChatLive.astro';
import SEO from '../components/seo/SEO.astro';
import Schema from '../components/seo/Schema.astro';
import { organizationSchema } from '../utils/schema';
import '../styles/global.css';
interface Props { title?: string; description?: string; type?: 'website' | 'article'; schema?: Record<string, unknown> | Record<string, unknown>[]; robots?: string; }
const { title, description, type = 'website', schema, robots } = Astro.props;
const schemas = schema ? [organizationSchema(Astro.site!), ...(Array.isArray(schema) ? schema : [schema])] : organizationSchema(Astro.site!);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="theme-color" content="#071a2d" />
    <link rel="icon" type="image/png" href="/favicon/favicon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <SEO {title} {description} canonical={Astro.url} {type} {robots} />
    <Schema data={schemas} />
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <Header />
    <main id="main-content"><slot /></main>
    <Footer />
    <ChatLive />
    <script>
      import { initScrollAnimation } from '../components/interactive/ScrollAnimation';
      initScrollAnimation();
    </script>
  </body>
</html>
