---
import { getCollection } from 'astro:content';
const insights = (await getCollection('insights')).sort((a,b)=>b.data.publishedAt.valueOf()-a.data.publishedAt.valueOf());
---
<section class="section">
  <div class="container insights-wrap">
    <div class="insight-title" data-reveal><p class="eyebrow">Field notes</p><h2>Ideas for the next growth decision.</h2><a href="/insights/">Explore all insights ↗</a></div>
    <div class="insight-list">{insights.map(item => <a href={`/insights/${item.id}/`} data-reveal><div><span>{item.data.topic}</span><span>{item.data.readingTime}</span></div><h3>{item.data.title}</h3><p>{item.data.description}</p></a>)}</div>
  </div>
</section>
<style>
  .insights-wrap { display: grid; grid-template-columns: 1fr 1.5fr; gap: clamp(3rem,8vw,8rem); }
  .insight-title { position: sticky; top: 7rem; align-self: start; }
  .insight-title h2 { margin: 1rem 0 2rem; font-size: clamp(2.8rem,5vw,5.5rem); }
  .insight-list { border-top: 1px solid var(--ink); }
  .insight-list a { display: grid; gap: 1rem; padding-block: 2rem; border-bottom: 1px solid var(--line); text-decoration: none; }
  .insight-list a > div { display: flex; justify-content: space-between; font-size: .75rem; text-transform: uppercase; letter-spacing: .08em; }
  .insight-list h3 { font-size: clamp(1.8rem,3vw,3rem); }
  .insight-list p { color: var(--muted); }
  @media (max-width: 760px) { .insights-wrap { grid-template-columns: 1fr; } .insight-title { position: static; } }
</style>
