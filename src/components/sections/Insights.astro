---
import { getCollection } from 'astro:content';
const insights = (await getCollection('insights')).sort((a,b)=>b.data.publishedAt.valueOf()-a.data.publishedAt.valueOf()).slice(0,3);
---
<section class="insights" aria-labelledby="insights-title">
  <div class="container">
    <p class="eyebrow">Notes from the operation</p>
    <div class="insights-head">
      <h2 id="insights-title">Latest insights from our team</h2>
      <a href="/insights/">View all <span aria-hidden="true">→</span></a>
    </div>
    <div class="insight-grid">{insights.map(item => (
      <article>
        <span>{item.data.topic} · {item.data.readingTime}</span>
        <h3><a href={`/insights/${item.id}/`}>{item.data.title}</a></h3>
        <p>{item.data.description}</p>
        <a class="read" href={`/insights/${item.id}/`}>Read more <span aria-hidden="true">→</span></a>
      </article>
    ))}</div>
  </div>
</section>

<style>
  .insights { padding-block:clamp(3.5rem,6vw,5rem); background:#fff; }
  .insights-head { display:flex; align-items:end; justify-content:space-between; gap:2rem; margin:.75rem 0 2.5rem; }
  .insights h2 { max-width:18ch; font-size:clamp(2.6rem,5vw,5rem); }
  .insights-head > a, .read { color:var(--green); font-weight:850; text-decoration:none; }
  .insight-grid { display:grid; grid-template-columns:repeat(3,1fr); border-top:1px solid var(--line); border-bottom:1px solid var(--line); }
  article { display:flex; flex-direction:column; min-height:15.5rem; padding:1.5rem; border-right:1px solid var(--line); }
  article:last-child { border-right:0; }
  article > span { color:var(--muted); font-size:.7rem; text-transform:uppercase; letter-spacing:.1em; }
  article h3 { margin:1rem 0; font-size:clamp(1.45rem,2.2vw,2.15rem); line-height:1.05; }
  article h3 a { text-decoration:none; }
  article p { display:none; color:var(--muted); }
  .read { margin-top:auto; padding-top:1.5rem; }
  @media (max-width:700px) { .insight-grid { grid-template-columns:1fr; } article { min-height:auto; border-right:0; border-bottom:1px solid var(--line); } article p { display:block; } article:last-child { border-bottom:0; } }
</style>
