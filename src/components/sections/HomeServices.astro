---
const services = [
  { number:'01', title:'GTM Launch Sprint', description:'Live campaigns and real performance data in 4 to 6 weeks.', word:'LAUNCH', href:'/services/gtm-launch-sprint/', tone:'white' },
  { number:'02', title:'Growth Operations Retainer', description:'A specialist team running experiments, analytics and reporting.', word:'GROW', href:'/services/growth-operations/', tone:'mint' },
  { number:'03', title:'AI Automation Buildout', description:'Connected AI workflows that remove manual work.', word:'AUTOMATE', href:'/services/ai-automation/', tone:'green' },
  { number:'04', title:'À La Carte Services', description:'Influencer and UGC, paid ads, SEO, AEO and GEO.', word:'FLEXIBLE', href:'/services/', tone:'dark' }
];
---
<section class="home-services" aria-labelledby="services-title">
  <div class="container services-heading">
    <p class="eyebrow">Our services</p>
    <h2 id="services-title">Four ways to bring us into your growth operation</h2>
  </div>
  <ol>{services.map(service => (
    <li class:list={['service-band', `service-band--${service.tone}`]}>
      <div class="container band-inner">
        <span class="number" aria-hidden="true">{service.number}</span>
        <div class="service-copy">
          <h3>{service.title}</h3>
          <p>{service.description}</p>
          <a href={service.href}>Learn more <span aria-hidden="true">→</span></a>
        </div>
        <strong class:list={['service-word', service.word.length > 6 && 'service-word--long']} aria-hidden="true">{service.word}</strong>
      </div>
    </li>
  ))}</ol>
</section>

<style>
  .home-services { background:#fff; }
  .services-heading { padding-block: clamp(3rem, 5vw, 4.5rem) 1.5rem; }
  .services-heading h2 { max-width: 22ch; margin-top: .7rem; font-size: clamp(2.5rem, 5vw, 5rem); }
  .home-services ol { margin:0; padding:0; list-style:none; }
  .service-band { min-height: 10rem; overflow:hidden; border-top:1px solid var(--line); }
  .service-band--white { background:#fff; }
  .service-band--mint { background:var(--silver-soft); }
  .service-band--green {
    background:linear-gradient(110deg, var(--green-dark) 0%, var(--green) 55%, #07983a 100%);
    color:var(--white);
  }
  .service-band--dark { background:var(--ink); color:#fff; }
  .band-inner { position:relative; display:grid; grid-template-columns:8.5rem minmax(18rem, 27rem) minmax(0, 1fr); align-items:center; min-height:10rem; }
  .number { position:relative; z-index:1; color:var(--display-light); font-size:clamp(5rem, 8vw, 7.5rem); font-weight:900; letter-spacing:-.08em; line-height:.75; opacity:.78; }
  .service-band--green .number, .service-band--dark .number { color:var(--display-dark); opacity:1; }
  .service-copy { position:relative; z-index:2; padding:1.35rem .75rem; }
  .service-copy h3 { font-size:clamp(1.7rem, 3vw, 2.8rem); }
  .service-copy p { max-width:24rem; margin:.45rem 0 1rem; color:var(--muted); }
  .service-band--dark .service-copy p, .service-band--green .service-copy p { color:#c8d0d8; }
  .service-copy a { display:inline-flex; gap:1.5rem; color:var(--green); font-weight:850; text-decoration:none; }
  .service-band--dark .service-copy a { color:var(--green); }
  .service-band--green .service-copy a { color:var(--white); }
  .band-inner > strong { position:relative; z-index:1; grid-column:3; justify-self:end; max-width:100%; color:var(--display-light); font-size:clamp(3.5rem, 6.5vw, 7rem); font-weight:900; line-height:.78; letter-spacing:-.08em; white-space:nowrap; opacity:.72; user-select:none; }
  .band-inner > .service-word--long { padding-right:.25rem; font-size:clamp(2.65rem, 4.8vw, 5.25rem); }
  .service-band--green .number,
  .service-band--green strong { color:rgba(216, 240, 223, .30); opacity:1; }
  .service-band--dark strong { color:var(--display-dark); opacity:1; }
  @media (max-width:700px) {
    .band-inner { grid-template-columns:5.5rem 1fr; grid-template-rows:auto auto; min-height:18rem; }
    .band-inner > strong, .band-inner > .service-word--long { grid-column:1 / -1; grid-row:2; justify-self:end; padding:.25rem 0 .85rem; font-size:clamp(3rem, 13vw, 4.5rem); opacity:.62; }
    .number { align-self:start; padding-top:2.5rem; font-size:5rem; }
  }
</style>
