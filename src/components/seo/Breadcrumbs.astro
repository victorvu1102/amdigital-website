---
import Schema from './Schema.astro';
interface Item { label: string; href: string; }
const { items } = Astro.props as { items: Item[] };
const schema = { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: items.map((item, index) => ({ '@type': 'ListItem', position: index + 1, name: item.label, item: new URL(item.href, Astro.site).toString() })) };
---
<nav class="breadcrumbs container" aria-label="Breadcrumb">
  <ol>{items.map((item, i) => <li><a href={item.href}>{item.label}</a>{i < items.length - 1 && <span aria-hidden="true">/</span>}</li>)}</ol>
</nav>
<Schema data={schema} />
<style>
  .breadcrumbs { padding-block: 1rem; }
  ol { display: flex; flex-wrap: wrap; gap: .6rem; margin: 0; padding: 0; list-style: none; }
  li, a { font-size: .78rem; text-transform: uppercase; letter-spacing: .08em; }
  li { display: flex; gap: .6rem; }
</style>
