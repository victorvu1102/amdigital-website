---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout title="Thank you | AM Digital" description="Thank you for contacting AM Digital. Our team will review your enquiry and reply shortly.">
  <article class="thanks-page">
    <section class="thanks-panel" aria-labelledby="thanks-title">
      <div class="container">
        <p class="eyebrow">Message received</p>
        <h1 id="thanks-title">Thank you.<br /><span>We’ll be in touch.</span></h1>
        <p>Your enquiry has been sent to the AM Digital team. We’ll review the context and reply with a practical next step.</p>
        <div class="actions">
          <a class="button button--green" href="/">Back to home <span aria-hidden="true">→</span></a>
          <a class="text-link" href="/services/">Explore our services</a>
        </div>
      </div>
    </section>
  </article>
</BaseLayout>

<style>
  .thanks-page { min-height:75vh; display:grid; background:var(--navy); color:var(--white); }
  .thanks-panel { display:grid; align-items:center; padding-block:clamp(4rem,10vw,9rem); overflow:hidden; }
  .thanks-panel .container { position:relative; }
  .thanks-panel .container::after { content:"SENT"; position:absolute; z-index:0; right:-.05em; top:50%; transform:translateY(-50%); color:rgba(39,216,104,.12); font-size:clamp(9rem,24vw,22rem); font-weight:900; line-height:.75; letter-spacing:-.08em; pointer-events:none; }
  .eyebrow { position:relative; z-index:1; color:var(--green-bright); }
  h1 { position:relative; z-index:1; max-width:12ch; margin:1rem 0 1.6rem; font-size:clamp(4rem,8vw,8rem); line-height:.85; }
  h1 span { color:var(--green-bright); }
  h1 + p { position:relative; z-index:1; max-width:42rem; color:var(--silver); font-size:clamp(1.05rem,1.5vw,1.25rem); }
  .actions { position:relative; z-index:1; display:flex; align-items:center; gap:2rem; margin-top:2.5rem; }
  .text-link { color:var(--white); font-weight:800; text-decoration:none; }
  @media (max-width:560px) { .actions { align-items:flex-start; flex-direction:column; } }
</style>
