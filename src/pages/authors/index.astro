---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
const authors=await getCollection('authors');
---
<BaseLayout title="Authors" description="Meet the operators behind AM Digital's field notes on global growth, creator marketing, search and automation.">
  <section class="section surface-dark"><div class="container"><p class="eyebrow">Authors</p><h1>The operators<br />behind the notes.</h1></div></section>
  <section class="section"><div class="container">{await Promise.all(authors.map(async author=>{const {Content}=await render(author);return <article class="author" id={author.id}><img class="author-logo" src="/images/am-logo.png" alt="AM Digital logo" width="512" height="512" loading="lazy" decoding="async" /><div><p class="eyebrow">{author.data.role}</p><h2>{author.data.name}</h2><p>{author.data.bio}</p><div class="bio"><Content /></div></div></article>}))}</div></section>
</BaseLayout>
<style>.author{display:grid;grid-template-columns:12rem 1fr;gap:3rem;max-width:60rem}.author-logo{display:block;width:100%;aspect-ratio:1;object-fit:contain}.author h2{margin:1rem 0}.author p{max-width:45rem}.bio{margin-top:1rem;color:var(--muted)}@media(max-width:600px){.author{grid-template-columns:1fr}.author-logo{width:8rem}}</style>
