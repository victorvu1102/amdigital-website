---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
const authors=await getCollection('authors');
---
<BaseLayout title="Authors" description="Meet the operators behind AM Digital's field notes on global growth, creator marketing, search and automation.">
  <section class="section surface-dark"><div class="container"><p class="eyebrow">Authors</p><h1>The operators<br />behind the notes.</h1></div></section>
  <section class="section"><div class="container">{await Promise.all(authors.map(async author=>{const {Content}=await render(author);return <article class="author" id={author.id}><div class="monogram">AM</div><div><p class="eyebrow">{author.data.role}</p><h2>{author.data.name}</h2><p>{author.data.bio}</p><div class="bio"><Content /></div></div></article>}))}</div></section>
</BaseLayout>
<style>.author{display:grid;grid-template-columns:12rem 1fr;gap:3rem;max-width:60rem}.monogram{display:grid;place-items:center;aspect-ratio:1;border-radius:50%;background:var(--green);font-size:3rem;font-weight:950}.author h2{margin:1rem 0}.author p{max-width:45rem}.bio{margin-top:1rem;color:var(--muted)}@media(max-width:600px){.author{grid-template-columns:1fr}.monogram{width:8rem}}</style>
