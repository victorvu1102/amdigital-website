---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
const posts = (await getCollection('insights')).sort((a,b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf());
const [featured, ...morePosts] = posts;
const formatDate = (date: Date) => date.toLocaleDateString('en-GB', { day:'2-digit', month:'short', year:'numeric' });
---
<BaseLayout title="Blog" description="Practical articles on creator operations, go-to-market systems, SEO, GEO and AI marketing automation.">
  <section class="blog-hero"><div class="hero-word" aria-hidden="true">FIELD<br />NOTES</div><div class="container hero-inner"><p class="eyebrow">AM Digital Blog</p><h1>Ideas from<br />inside the work.</h1><p class="hero-copy">Practical notes on global campaigns, creator operations, market entry, search visibility and AI-powered growth systems.</p></div></section>
  {featured && <section class="featured-wrap" aria-labelledby="latest-article"><div class="container"><a class="featured-card" href={`/blog/${featured.id}/`}><div class="featured-index" aria-hidden="true">01</div><div class="featured-main"><div class="post-meta"><span>{featured.data.topic}</span><time datetime={featured.data.publishedAt.toISOString()}>{formatDate(featured.data.publishedAt)}</time><span>{featured.data.readingTime}</span></div><p class="eyebrow">Latest article</p><h2 id="latest-article">{featured.data.title}</h2><p class="summary">{featured.data.description}</p><strong>Read the article <span aria-hidden="true">↗</span></strong></div><div class="featured-mark" aria-hidden="true">READ</div></a></div></section>}
  <section class="archive" aria-labelledby="archive-title"><div class="container"><div class="archive-head"><div><p class="eyebrow">From the operation</p><h2 id="archive-title">More field notes.</h2></div><p>Strategy, execution and lessons from campaigns across markets.</p></div><div class="post-grid">{morePosts.map((item,index)=><a class="post-card" href={`/blog/${item.id}/`}><div class="card-top"><span class="card-number">{String(index+2).padStart(2,'0')}</span><span class="topic">{item.data.topic}</span></div><h3>{item.data.title}</h3><p>{item.data.description}</p><div class="card-footer"><time datetime={item.data.publishedAt.toISOString()}>{formatDate(item.data.publishedAt)}</time><strong>Read <span aria-hidden="true">→</span></strong></div></a>)}</div></div></section>
  <section class="blog-cta"><div class="container cta-inner"><div><p class="eyebrow">Have a growth question?</p><h2>Let’s work it out.</h2></div><a class="button" href="/contact/">Talk to our team <span aria-hidden="true">→</span></a></div></section>
</BaseLayout>
<style>
  .blog-hero{position:relative;min-height:39rem;overflow:hidden;background:var(--green-soft)}.hero-inner{position:relative;z-index:1;display:flex;min-height:39rem;flex-direction:column;justify-content:center;padding-block:5rem}.hero-inner h1{max-width:8ch;margin:.9rem 0 1.7rem;font-size:clamp(4.2rem,10vw,9rem)}.hero-copy{max-width:38rem;color:var(--navy-soft)}.hero-word{position:absolute;right:-.025em;bottom:-.17em;color:rgba(0,126,40,.12);font-size:clamp(9rem,24vw,22rem);font-weight:900;letter-spacing:-.09em;line-height:.63;text-align:right}
  .featured-wrap{padding:clamp(3rem,6vw,5.5rem) 0;background:var(--paper)}.featured-card{position:relative;display:grid;grid-template-columns:8rem minmax(0,1fr);min-height:32rem;overflow:hidden;border-radius:var(--radius);background:var(--navy);color:var(--white);text-decoration:none}.featured-index{display:grid;place-items:start center;padding-top:2.5rem;border-right:1px solid rgba(255,255,255,.2);color:var(--green-bright);font-size:3.5rem;font-weight:850}.featured-main{position:relative;z-index:1;display:flex;max-width:55rem;flex-direction:column;padding:2.5rem clamp(2rem,5vw,5rem)}.post-meta{display:flex;flex-wrap:wrap;gap:.6rem 1.5rem;color:var(--silver);font-size:.75rem;font-weight:750;letter-spacing:.08em;text-transform:uppercase}.featured-main>.eyebrow{margin-top:auto;color:var(--green-bright)}.featured-main h2{max-width:13ch;margin:.7rem 0 1.2rem;font-size:clamp(2.7rem,6vw,5.8rem)}.featured-main .summary{max-width:43rem;color:var(--silver)}.featured-main strong{margin-top:2rem;color:var(--green-bright)}.featured-mark{position:absolute;right:-.04em;bottom:-.18em;color:rgba(255,255,255,.055);font-size:clamp(8rem,20vw,18rem);font-weight:900;letter-spacing:-.08em}.featured-card:hover strong,.post-card:hover .card-footer strong{color:var(--green-bright)}
  .archive{padding:clamp(4rem,8vw,7rem) 0;background:var(--white)}.archive-head{display:flex;align-items:end;justify-content:space-between;gap:2rem;margin-bottom:3rem}.archive-head h2{margin-top:.7rem;font-size:clamp(3rem,6vw,6rem)}.archive-head>p{max-width:25rem;color:var(--muted)}.post-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));border-top:1px solid var(--line);border-left:1px solid var(--line)}.post-card{display:flex;min-height:28rem;flex-direction:column;padding:clamp(1.5rem,3vw,2.5rem);border-right:1px solid var(--line);border-bottom:1px solid var(--line);color:var(--ink);text-decoration:none;transition:background .2s ease,color .2s ease}.post-card:hover{background:var(--green-soft)}.card-top,.card-footer{display:flex;align-items:center;justify-content:space-between;gap:1rem}.card-number{color:var(--green);font-size:2.3rem;font-weight:850}.topic,.card-footer{font-size:.75rem;font-weight:800;letter-spacing:.08em;text-transform:uppercase}.topic{color:var(--green);text-align:right}.post-card h3{max-width:15ch;margin:4rem 0 1rem;font-size:clamp(2rem,4vw,3.8rem)}.post-card>p{max-width:34rem;color:var(--muted)}.card-footer{margin-top:auto;padding-top:2rem;border-top:1px solid var(--line)}.card-footer time{color:var(--muted)}
  .blog-cta{background:var(--green);color:var(--white)}.cta-inner{display:flex;min-height:20rem;align-items:center;justify-content:space-between;gap:2rem;padding-block:3rem}.cta-inner h2{margin-top:.5rem;font-size:clamp(3.2rem,7vw,7rem)}
  @media(max-width:760px){.blog-hero,.hero-inner{min-height:34rem}.hero-word{bottom:-.08em;font-size:36vw;line-height:.72}.featured-card{grid-template-columns:1fr;min-height:36rem}.featured-index{display:none}.featured-main{padding:1.5rem}.featured-main>.eyebrow{margin-top:5rem}.archive-head,.cta-inner{align-items:flex-start;flex-direction:column}.post-grid{grid-template-columns:1fr}.post-card{min-height:24rem}.cta-inner{justify-content:center}}
</style>
