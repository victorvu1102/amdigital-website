---
import { getCollection, render } from 'astro:content';
import ArticleLayout from '../../layouts/ArticleLayout.astro';
export async function getStaticPaths(){return (await getCollection('insights')).map(entry=>({params:{slug:entry.id},props:{entry}}));}
const {entry}=Astro.props; const {Content}=await render(entry);
---
<ArticleLayout {...entry.data} slug={entry.id}><Content /></ArticleLayout>
