---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
const cases=(await getCollection('cases')).sort((a,b)=>a.data.order-b.data.order);
const identities:Record<string,{word:string;logo:string}>={
  'mode-chocolate':{word:'CREATE',logo:'/partners/mode-chocolate.svg'},
  perplexity:{word:'SCALE',logo:'/partners/perplexity.svg'},
  'speak-ai':{word:'LOCAL',logo:'/partners/speak.svg'},
  gleam:{word:'RANK',logo:'/partners/gleam.svg'},
};
---
<BaseLayout title="Case Studies" description="Selected AM Digital work across creator operations, market entry, growth marketing, SEO and GEO.">
  <section class="case-index-hero">
    <div class="hero-word" aria-hidden="true">PROOF</div>
    <div class="container"><p class="eyebrow">Selected case studies</p><h1>Work that moved<br />the operation.</h1><p>Four partnerships. Four different growth problems. One operating principle: get close to the work and build what the next stage demands.</p></div>
    <img src="/images/am-green-ribbon-v2.webp" alt="" width="1600" height="620" loading="eager" />
  </section>
  <section class="case-grid-section"><div class="container case-grid">
    {cases.map((item)=>{const identity=identities[item.id];return <a class={`case-card case-card--${item.id}`} href={`/case-studies/${item.id}/`}>
      <div class="card-word" aria-hidden="true">{identity.word}</div>
      <div class="card-top"><span class="card-number">{String(item.data.order).padStart(2,'0')}</span><img src={identity.logo} alt={`${item.data.title} logo`} width="220" height="72" loading="lazy" /></div>
      <div class="card-copy"><p class="eyebrow">{item.data.market} · {item.data.category}</p><h2>{item.data.title}</h2><p>{item.data.summary}</p></div>
      <div class="card-metrics">{item.data.metrics.map((metric)=><span><strong>{metric.value}</strong>{metric.label}</span>)}</div>
      <span class="card-link">View case study <b aria-hidden="true">↗</b></span>
    </a>})}
  </div></section>
  <section class="case-index-cta"><div class="container"><p class="eyebrow">Your next move</p><h2>Bring us the growth problem.<br /><span>We’ll build the operation.</span></h2><a class="cta-button" href="/contact/">Let’s Talk <span aria-hidden="true">→</span></a></div></section>
</BaseLayout>
<style>
  .case-index-hero{position:relative;min-height:39rem;overflow:hidden;background:var(--navy);color:var(--white)}.case-index-hero .container{position:relative;z-index:2;display:grid;align-content:center;min-height:inherit;padding-block:6rem}.case-index-hero .eyebrow{color:var(--green-bright)}.case-index-hero h1{max-width:12ch;margin:1rem 0 1.5rem;font-size:clamp(4rem,9vw,8.5rem);line-height:.84;letter-spacing:-.075em}.case-index-hero p:last-of-type{max-width:40rem;color:var(--silver)}
  .hero-word{position:absolute;z-index:0;right:-1%;top:0;color:rgba(50,216,117,.15);font-size:clamp(9rem,25vw,24rem);font-weight:900;line-height:.85;letter-spacing:-.1em}.case-index-hero>img{position:absolute;z-index:1;right:-10rem;bottom:-14rem;width:min(72rem,78vw);opacity:.48}
  .case-grid-section{padding-block:var(--space-section);background:#eef3f0}.case-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:1rem}
  .case-card{--card-bg:var(--white);--card-fg:var(--ink);--card-accent:var(--green);--card-ghost:rgba(0,126,40,.08);position:relative;display:grid;min-height:39rem;overflow:hidden;padding:clamp(1.5rem,4vw,3rem);background:var(--card-bg);color:var(--card-fg);text-decoration:none;transition:transform .25s ease,box-shadow .25s ease}.case-card:hover{transform:translateY(-6px);box-shadow:0 22px 55px rgba(7,26,45,.14)}
  .case-card--perplexity{--card-bg:var(--navy);--card-fg:var(--white);--card-accent:var(--green-bright);--card-ghost:rgba(50,216,117,.14)}.case-card--speak-ai{--card-bg:var(--green);--card-fg:var(--white);--card-accent:#b6f3cc;--card-ghost:rgba(255,255,255,.12)}.case-card--gleam{--card-bg:#dff3e6;--card-ghost:rgba(0,126,40,.1)}
  .card-word{position:absolute;right:-1%;bottom:13%;color:var(--card-ghost);font-size:clamp(6rem,13vw,12rem);font-weight:900;line-height:.8;letter-spacing:-.09em}.card-top,.card-copy,.card-metrics,.card-link{position:relative;z-index:1}.card-top{display:flex;justify-content:space-between;align-items:flex-start;gap:2rem}.card-number{font-size:clamp(4.5rem,8vw,7rem);font-weight:900;line-height:.8;letter-spacing:-.08em;color:var(--card-ghost)}
  .card-top img{width:min(10rem,40%);height:3.4rem;object-fit:contain;object-position:right top}
  .card-copy{align-self:end;margin-top:clamp(4rem,9vw,9rem)}.card-copy .eyebrow{max-width:28rem;color:var(--card-accent)}.card-copy h2{margin:.8rem 0 1rem;font-size:clamp(3rem,6vw,5.5rem);line-height:.88;letter-spacing:-.065em;overflow-wrap:anywhere}.card-copy>p:last-child{max-width:35rem;color:color-mix(in srgb,var(--card-fg) 72%,transparent);font-size:1rem}
  .card-metrics{display:grid;grid-template-columns:repeat(3,1fr);gap:.8rem;margin-top:2.5rem;padding-top:1.5rem;border-top:1px solid color-mix(in srgb,var(--card-fg) 18%,transparent)}.card-metrics span{display:grid;align-content:start;font-size:.62rem;line-height:1.3;letter-spacing:.05em;text-transform:uppercase}.card-metrics strong{margin-bottom:.35rem;color:var(--card-accent);font-size:clamp(1.4rem,3vw,2.2rem);line-height:1;letter-spacing:-.04em;text-transform:none}
  .card-link{display:flex;justify-content:space-between;align-items:center;margin-top:2rem;font-size:.8rem;font-weight:800;text-transform:uppercase;letter-spacing:.08em}.card-link b{font-size:1.8rem}
  .case-index-cta{padding-block:clamp(5rem,9vw,8rem);background:var(--green-bright);color:var(--ink)}.case-index-cta .eyebrow{color:var(--green-dark)}.case-index-cta h2{margin:1rem 0 2rem;font-size:clamp(3rem,7vw,6.5rem);line-height:.88;letter-spacing:-.07em}.case-index-cta h2 span{color:var(--white)}.cta-button{display:inline-flex;gap:2rem;align-items:center;padding:1rem 1.5rem;border-radius:999px;background:var(--ink);color:var(--white);text-decoration:none}
  @media(max-width:800px){.case-grid{grid-template-columns:1fr}.case-card{min-height:34rem}.hero-word{top:8%}.case-index-hero>img{right:-24rem;width:58rem}}@media(max-width:520px){.case-index-hero{min-height:34rem}.case-index-hero h1{font-size:clamp(3.6rem,18vw,5rem)}.case-card{min-height:37rem}.card-metrics{gap:.4rem}}
</style>
