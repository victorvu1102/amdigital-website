---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Contact" description="Start a conversation with AM Digital about global GTM, creator operations, search visibility or AI marketing automation.">
  <section class="contact section surface-dark"><div class="container contact-grid"><div><p class="eyebrow">Start a conversation</p><h1>What market move are you planning?</h1><p>Tell us where you are now, where you want to go and what is slowing the team down. We’ll reply with a practical next step.</p></div><div class="contact-card"><span class="eyebrow">Email</span><a href="mailto:contact@amdigital.ninja">contact@amdigital.ninja</a><span class="eyebrow">Office</span><address>Floor 4, Viwaseen Tower<br />48 To Huu Street<br />Hanoi, Vietnam</address><span class="eyebrow">Website</span><a href="https://amdigital.ninja" rel="noopener noreferrer">amdigital.ninja ↗</a></div></div></section>
</BaseLayout>
<style>.contact{min-height:75vh;display:grid;align-items:center}.contact-grid{display:grid;grid-template-columns:1.5fr 1fr;gap:clamp(3rem,8vw,8rem);align-items:center}.contact h1{max-width:10ch}.contact h1+p{margin-top:2rem;max-width:42rem;color:#b8c3be}.contact-card{display:grid;gap:1rem;padding:2rem;border:1px solid rgba(255,255,255,.25);border-radius:var(--radius);background:var(--ink-soft)}.contact-card .eyebrow:not(:first-child){margin-top:1.5rem}.contact-card a{font-size:clamp(1.2rem,2vw,1.8rem);font-weight:800;color:var(--green)}address{font-style:normal;line-height:1.6;color:#c4cec9}@media(max-width:760px){.contact-grid{grid-template-columns:1fr}}</style>
